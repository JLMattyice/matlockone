# Which database this deployment uses. The scheme decides everything else:
# the driver adapter, which Prisma schema the CLI acts on, and whether searches
# ask for case-insensitive matching. There is no default — an unrecognised URL
# is rejected at startup rather than guessed at.
#
#   Hosted:  postgresql://user:password@host:5432/matlockone
#   Desktop: file:./dev.db
#
# A desktop install never sees this file; electron/runtime.js points the server
# at a SQLite file under the user's own AppData folder.
DATABASE_URL="file:./dev.db"

# Signs session cookies.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-32-random-characters"

# Encrypts integration credentials (mail passwords, payment API keys) before
# they are written to the database. Generate it the same way, and keep it out
# of backups that travel with the database file. Losing it means every
# connected account must be re-entered.
ENCRYPTION_KEY="change-me-to-32-random-characters"

# ---------------------------------------------------------------------------
# File storage. Photos, documents and signed paperwork.
#
# Left unset, files are written to STORAGE_DIR on this machine — right for a
# desktop install and for local development, and refused outright on Vercel,
# whose filesystem is read-only and per-invocation. Uploads there would appear
# to succeed and be gone by the next request, so the app declines to start
# instead.
#
# STORAGE_PROVIDER is optional: with none set, S3 is chosen when its bucket and
# key are present, then Vercel Blob when its token is.
# ---------------------------------------------------------------------------

# One of: local, s3, vercel-blob
# STORAGE_PROVIDER="s3"

# Where the local adapter writes. Ignored by the cloud providers.
STORAGE_DIR="./storage"

# Any S3-compatible store: Cloudflare R2, Amazon S3, Backblaze B2, Supabase
# Storage, MinIO. The bucket must be private — every read is served through
# /api/files/[id], which checks the session and the organization first, and a
# public bucket would make that check decorative.
#
# Recommended for a hosted deployment: it is the only provider that can hand
# uploads straight to the browser AND is not tied to one company's platform.
# The bucket must be private. See DEPLOY.md.
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Required for Supabase, R2, Backblaze and MinIO; omit for Amazon S3.
# S3_ENDPOINT="https://<project-ref>.supabase.co/storage/v1/s3"

# Most stores ignore the region but require one. Defaults to "auto".
# S3_REGION="auto"

# MinIO and some self-hosted stores cannot do virtual-host addressing.
# S3_FORCE_PATH_STYLE="false"

# Vercel Blob. Added automatically once a Blob store is connected to the
# project. Files are written with private access.
# BLOB_READ_WRITE_TOKEN=""

# Base for the client-facing estimate and invoice links that get emailed out.
APP_URL="http://localhost:3000"

# "false" closes public sign-up: no form, no link to it, and the action refuses.
# Set it on a hosted deployment once its owner has an account; the crew is
# added under Team. Leave it unset on desktop, whose first screen is sign-up.
# ALLOW_SIGNUP="false"

# The sign-in emails of whoever runs Matlock One itself, comma-separated. They
# get an "Accounts" page across every business: sign-ups, who pays, the monthly
# total. Unset, nobody does. Hosted deployment only.
# OPERATOR_EMAILS="you@example.com"

# ---------------------------------------------------------------------------
# The morning automation run. Hosted deployment only.
#
# Vercel calls /api/cron/automations every morning (vercel.json) and sends this
# as a bearer token; the route refuses any call without it. Unset, the two
# automations that wait for a date — chasing overdue invoices, checking in on
# quiet customers — only run when somebody presses Check now, and the boot log
# says so. At least 16 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# A desktop install has no scheduler and needs none of this.
# ---------------------------------------------------------------------------

# CRON_SECRET=""

# ---------------------------------------------------------------------------
# Fallback desktop download links. Optional, and hosted deployment only.
#
# The download buttons find the newest installer on GitHub Releases by
# themselves (src/lib/releases.ts), so a release reaches them without anybody
# setting these. They are used only when github.com cannot be reached at the
# moment somebody clicks — pointing at a known-good installer is better than
# sending them to the list of releases.
#
# Leaving an old version here is harmless: it is a fallback, not the answer.
# The repository has to be public for any of this, fallback included, to be
# downloadable without a token.
# ---------------------------------------------------------------------------

# DOWNLOAD_URL_WINDOWS="https://github.com/JLMattyice/matlockone/releases/download/v0.3.0/MatlockOne-Setup-0.3.0.exe"

# DOWNLOAD_URL_MACOS="https://github.com/JLMattyice/matlockone/releases/download/v0.3.0/MatlockOne-0.3.0-x64.dmg"

# ---------------------------------------------------------------------------
# Selling Matlock One. Hosted deployment only — a desktop install has none of
# these, and so can neither issue a licence nor take a payment. That is
# deliberate.
# ---------------------------------------------------------------------------

# Signs licence keys for desktop installs that keep their own data. Needed
# only where `npm run sale` is run, not on the hosted deployment. The public
# half is committed in src/lib/license/public-key.ts; this half must never be.
# Created by `npm run license:keygen`, which writes it to license-keys/
# (gitignored). Losing it means no existing licence can ever be renewed.
# LICENSE_PRIVATE_KEY_FILE="./license-keys/signing.private.pem"
# LICENSE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# QuickBooks Online — Matlock Software's Intuit app, which every business
# connects its own QuickBooks company to from Settings → QuickBooks. Without
# both keys the page says QuickBooks is not set up here. The Intuit app must
# list {APP_URL}/api/integrations/quickbooks/callback as a redirect URI.
# QUICKBOOKS_CLIENT_ID=""
# QUICKBOOKS_CLIENT_SECRET=""

# "production" once Intuit has issued production keys. Anything else stays on
# sandbox, which only reaches Intuit's test companies.
# QUICKBOOKS_ENVIRONMENT="sandbox"

# Push notifications to phones and browsers (Settings → Your profile). A key
# pair that proves to the push services that messages come from this app; make
# one with `npx web-push generate-vapid-keys`. Without both keys nothing is
# offered. Changing them later signs every device out of notifications.
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# Who the push services may contact about this sender (mailto: or https:).
# VAPID_SUBJECT="mailto:matlock@matlocksoftware.com"

# PayPal Subscriptions — how every hosted business pays. There is no free
# tier, so without these a new account can sign up but never open. Checkout is
# offered only when all three are set. `npm run paypal:setup` creates the
# product, the six plans and the webhook, and prints every value below.
# PAYPAL_CLIENT_ID=""
# PAYPAL_CLIENT_SECRET=""
# PAYPAL_WEBHOOK_ID=""

# "live" switches to the production API. Anything else stays on sandbox.
# PAYPAL_ENV="sandbox"

# Billing plan ids, printed by `npm run paypal:setup`. A plan with no id here
# is simply not for sale, and a payment against an unmapped plan is logged
# rather than guessed at.
# PAYPAL_PLAN_STARTER_MONTHLY=""
# PAYPAL_PLAN_STARTER_ANNUAL=""
# PAYPAL_PLAN_BUSINESS_MONTHLY=""
# PAYPAL_PLAN_BUSINESS_ANNUAL=""
# PAYPAL_PLAN_PRO_MONTHLY=""
# PAYPAL_PLAN_PRO_ANNUAL=""
# The launch-week offer's monthly plans: the first month at half price, then
# the full price. Without them the offer is neither shown nor sold. Keep them
# after the week ends — renewals on those subscriptions are matched by them.
# PAYPAL_PLAN_STARTER_MONTHLY_LAUNCH=""
# PAYPAL_PLAN_BUSINESS_MONTHLY_LAUNCH=""
# PAYPAL_PLAN_PRO_MONTHLY_LAUNCH=""

# The free-month plans from the first version of free-month codes, which gave
# the month through PayPal. Codes no longer use them — a code now opens a
# month with no payment at all — but keep them for as long as anybody is on
# one, like the launch plans.
# PAYPAL_PLAN_STARTER_MONTHLY_TRIAL=""
# PAYPAL_PLAN_BUSINESS_MONTHLY_TRIAL=""
# PAYPAL_PLAN_PRO_MONTHLY_TRIAL=""

# Matlock's own sending mailbox, used for "Forgot password?" links and to
# email licence keys (`npm run sale -- --deliver`). Distinct from the email
# settings a customer configures in the app: those credentials belong to them
# and are encrypted per organization; these belong to us. A licence sale
# still completes without them — the key is stored and printed, and
# `--deliver` sends it once mail works.
# SYSTEM_MAIL_FROM_EMAIL="sales@matlocksoftware.com"
# SYSTEM_MAIL_FROM_NAME="Matlock One"

# Either a Resend key…
# SYSTEM_MAIL_RESEND_API_KEY=""

# …or your own SMTP. Port 465 is implicit TLS, 587 upgrades with STARTTLS;
# SYSTEM_MAIL_SMTP_SECURE overrides that guess if your host is unusual.
# SYSTEM_MAIL_SMTP_HOST=""
# SYSTEM_MAIL_SMTP_PORT="587"
# SYSTEM_MAIL_SMTP_USER=""
# SYSTEM_MAIL_SMTP_PASSWORD=""
