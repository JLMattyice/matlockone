DATABASE_URL="file:./dev.db"

# Signs session cookies.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-32-random-characters"

# Encrypts integration credentials (mail passwords, payment API keys) before
# they are written to the database. Generate it the same way, and keep it out
# of backups that travel with the database file. Losing it means every
# connected account must be re-entered.
ENCRYPTION_KEY="change-me-to-32-random-characters"

# Where uploaded documents and photos are written by the local storage adapter.
STORAGE_DIR="./storage"

# Base for the client-facing estimate and invoice links that get emailed out.
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Selling Matlock One. Hosted deployment only — a desktop install has none of
# these, and so can neither issue a licence nor take a payment. That is
# deliberate.
# ---------------------------------------------------------------------------

# Signs licence keys. The public half is committed in
# src/lib/license/public-key.ts; this half must never be. Created by
# `npm run license:keygen`, which writes it to license-keys/ (gitignored).
# Losing it means no existing customer can ever be renewed.
# LICENSE_PRIVATE_KEY_FILE="./license-keys/signing.private.pem"
# LICENSE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# PayPal Subscriptions. Checkout is offered only when all three are set, so a
# half-configured deployment shows the free download instead of a button that
# would fail after taking someone's money.
# PAYPAL_CLIENT_ID=""
# PAYPAL_CLIENT_SECRET=""
# PAYPAL_WEBHOOK_ID=""

# "live" switches to the production API. Anything else stays on sandbox.
# PAYPAL_ENV="sandbox"

# Billing plan ids, created once in the PayPal dashboard. A plan with no id
# here is simply not for sale, and a payment against an unmapped plan is
# logged rather than guessed at.
# PAYPAL_PLAN_STARTER_MONTHLY=""
# PAYPAL_PLAN_STARTER_ANNUAL=""
# PAYPAL_PLAN_BUSINESS_MONTHLY=""
# PAYPAL_PLAN_BUSINESS_ANNUAL=""
# PAYPAL_PLAN_PRO_MONTHLY=""
# PAYPAL_PLAN_PRO_ANNUAL=""

# Matlock's own sending mailbox, used to email licence keys to buyers. Distinct
# from the email settings a customer configures in the app: those credentials
# belong to them and are encrypted per organization; these belong to us. A
# purchase has no organization to borrow a mailbox from anyway.
# Without these a sale still completes — the key is stored, shown on the
# thank-you page, and `npm run sale -- --deliver` sends it once mail works.
# SYSTEM_MAIL_FROM_EMAIL="sales@matlocksoftware.com"
# SYSTEM_MAIL_FROM_NAME="Matlock One"

# Either a Resend key…
# SYSTEM_MAIL_RESEND_API_KEY=""

# …or your own SMTP. Port 465 is implicit TLS, 587 upgrades with STARTTLS;
# SYSTEM_MAIL_SMTP_SECURE overrides that guess if your host is unusual.
# SYSTEM_MAIL_SMTP_HOST=""
# SYSTEM_MAIL_SMTP_PORT="587"
# SYSTEM_MAIL_SMTP_USER=""
# SYSTEM_MAIL_SMTP_PASSWORD=""
