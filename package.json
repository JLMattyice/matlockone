{
  "name": "matlock-one",
  "productName": "Matlock One",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop": "electron .",
    "desktop:pack": "npm run desktop:build && node scripts/make-icon.mjs && electron-builder --win",
    "desktop:pack:mac": "npm run desktop:build && node scripts/make-icon.mjs && electron-builder --mac",
    "desktop:pack:mac:unsigned": "CSC_IDENTITY_AUTO_DISCOVERY=false npm run desktop:pack:mac",
    "license:keygen": "tsx scripts/license-keygen.ts",
    "license:issue": "tsx scripts/license-issue.ts",
    "license:verify": "tsx scripts/license-verify.ts",
    "sale": "tsx scripts/sale-record.ts",
    "db:push": "prisma db push",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.34.0",
    "next": "^15.5.24",
    "nodemailer": "^9.0.6",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.3.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.26",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "description": "Field service management — clients, scheduling, jobs, estimates, invoicing and payments.",
  "author": {
    "name": "Matlock Software"
  },
  "main": "electron/main.js"
}
