<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Applied to the nested helper executables inside the bundle — Electron's own
  helpers, and the Node runtime in Contents/Resources/node that actually serves
  the application.

  The server process is the one that opens the database through the native
  SQLite binding, so it needs library validation disabled in its own right: an
  entitlement granted to the parent does not reach a child that carries its own
  signature.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
